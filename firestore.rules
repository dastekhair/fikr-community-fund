rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is a registered active member in the 'members' collection
    function getMemberData() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    function isRegisteredMember() {
      return isAuthenticated() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function isActiveMember() {
      return isRegisteredMember() && getMemberData().isActive == true;
    }

    function isAdmin() {
      return isActiveMember() && getMemberData().role == 'Admin';
    }

    function isTreasurer() {
      return isActiveMember() && (getMemberData().role == 'Treasurer' || getMemberData().role == 'Admin');
    }

    // Check if user is the creator within a 1-minute (60,000ms) undo window
    function isCreatorWithinUndoWindow(createdTimestamp, recordedById) {
      return isAuthenticated() &&
        recordedById != null &&
        recordedById == request.auth.uid &&
        createdTimestamp is timestamp &&
        (request.time.toMillis() - createdTimestamp.toMillis() < 60000);
    }

    /* ===============================================================
       1. MEMBERS COLLECTION
       - Read: Public (Member roster & transparency governance)
       - Write: Admin can manage all; Authenticated user can claim own UID doc
       =============================================================== */
    match /members/{memberId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuthenticated() && (request.auth.uid == memberId || !exists(/databases/$(database)/documents/members/$(memberId))));
    }

    /* ===============================================================
       2. CASES COLLECTION (Confidential Beneficiary Info)
       - Read: Active Core Members only
       - Create/Update: Active Core Members
       - Delete: Disabled to protect historical audit trail
       =============================================================== */
    match /cases/{caseId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember();
      allow delete: if false;
    }

    /* ===============================================================
       3. CASE COMMENTS COLLECTION
       - Read/Write: Active Core Members only
       =============================================================== */
    match /comments/{commentId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember();
      allow update, delete: if false;
    }

    /* ===============================================================
       4. WITHDRAWALS COLLECTION (Public Transparency Ledger)
       - Read: Public (everyone, including anonymous visitors)
       - Create: Active Core Members only
       - Delete: Disabled completely (no hard deletes)
       - Update: Only soft-voiding by Treasurer/Admin or creator within 1 min
       =============================================================== */
    match /withdrawals/{withdrawalId} {
      allow read: if true;
      allow create: if isActiveMember();
      allow delete: if false;
      allow update: if (
        (isTreasurer() || isAdmin() || isCreatorWithinUndoWindow(resource.data.timestamp, resource.data.recordedById)) &&
        request.resource.data.status == 'voided' &&
        request.resource.data.voidReason is string &&
        request.resource.data.voidReason.size() > 0 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voidedBy', 'voidedAt', 'voidReason'])
      );
    }

    /* ===============================================================
       5. CONTRIBUTIONS COLLECTION (Weekly Member Tracking)
       - Read: Public (Fund Inflow & Transparency Dashboard metrics)
       - Create: Active Core Members only
       - Delete: Disabled completely (no hard deletes)
       - Update: Confirmation by Treasurer/Admin OR soft-voiding
       =============================================================== */
    match /contributions/{contributionId} {
      allow read: if true;
      allow create: if isActiveMember();
      allow delete: if false;
      allow update: if (
        // Case A: Treasurer/Admin confirming contribution
        (
          (isTreasurer() || isAdmin()) &&
          request.resource.data.confirmedByTreasurer == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmedByTreasurer', 'confirmedBy', 'confirmedAt'])
        ) ||
        // Case B: Soft-voiding by Treasurer/Admin or creator within 1 min
        (
          (
            isTreasurer() ||
            isAdmin() ||
            (
              'createdAt' in resource.data &&
              'recordedById' in resource.data &&
              isCreatorWithinUndoWindow(resource.data.createdAt, resource.data.recordedById)
            )
          ) &&
          request.resource.data.status == 'voided' &&
          request.resource.data.voidReason is string &&
          request.resource.data.voidReason.size() > 0 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voidedBy', 'voidedAt', 'voidReason'])
        )
      );
    }
  }
}
