rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only authenticated active core members can upload and view verification files
    match /verification_proofs/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
